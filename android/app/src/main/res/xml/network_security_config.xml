<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow all HTTPS traffic (default) -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <!-- Allow cleartext HTTP for local WiFi backend server and dev hosts -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <!-- Local PC server IP — phone on same WiFi -->
        <domain includeSubdomains="false">10.62.19.85</domain>
        <!-- Common home/office subnets -->
        <domain includeSubdomains="true">192.168.1.1</domain>
        <domain includeSubdomains="true">192.168.0.1</domain>
        <!-- Broad 10.x subnet for hotspot / enterprise WiFi -->
        <domain includeSubdomains="true">10.0.0.0</domain>
    </domain-config>
</network-security-config>

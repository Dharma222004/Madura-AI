# ==============================================================================
# Madura AI Environment Configuration Example
# Copy this file to .env and configure your secrets.
# ==============================================================================

# Server Configuration
PORT=3001
NODE_ENV=development

# NVIDIA NIM API Configuration (Primary & Fallback)
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_API_KEYS=your_nvidia_api_key_1,your_nvidia_api_key_2
NVIDIA_MODEL=openai/gpt-oss-20b

# Google Gemini (Primary & Fallback)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEYS=your_gemini_api_key_1,your_gemini_api_key_2
GEMINI_MODEL=gemini-2.5-flash

# Groq (Primary & Fallback)
GROQ_API_KEY=your_groq_api_key_here
GROQ_API_KEYS=your_groq_api_key_1,your_groq_api_key_2
GROQ_MODEL=openai/gpt-oss-120b
GROQ_QWEN_MODEL=qwen/qwen3.8-27b
GROQ_WHISPER_MODEL=whisper-large-v3-turbo


# Fallback & Resilience
ENABLE_MOCK_FALLBACK=true

# Tavily Web Search (Primary & Fallback)
TAVILY_API_KEY=your_tavily_api_key_here
TAVILY_API_KEYS=your_tavily_key_1,your_tavily_key_2

# Storage & Upload Limits
DATA_DIR=./data
MAX_UPLOAD_SIZE_MB=25

# Supabase Persistent Memory Configuration
SUPABASE_URL=https://lpiylqfxfdddnhpnzwfc.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_WUKkS9J91fLfsjyu-JV5Zw_H3n_7xOE
VITE_SUPABASE_URL=https://lpiylqfxfdddnhpnzwfc.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_WUKkS9J91fLfsjyu-JV5Zw_H3n_7xOE

# NVIDIA NIM Embedding Model
NVIDIA_EMBEDDING_MODEL=nvidia/nemotron-3.5-embed-1b
NVIDIA_EMBEDDING_DIM=2048
